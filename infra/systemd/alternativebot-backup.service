[Unit]
Description=Create and verify a Alternative Bot production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/alternativebot/backup.env
ExecStart=/usr/local/sbin/alternativebot-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups

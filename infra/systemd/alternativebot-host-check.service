[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/alternativebot/backup.env
ExecStart=/usr/local/sbin/alternativebot-host-check
StateDirectory=alternativebot/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/alternativebot/alerts
ProtectHome=true
PrivateTmp=true
